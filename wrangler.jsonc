{
  "name": "alexgonz-dev",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "alexgonz.dev", "custom_domain": true }],
}
